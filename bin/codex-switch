#!/usr/bin/env bash
# codex-switch — 在 Codex 官方订阅(ChatGPT 登录)与 cctq relay(API key)之间切换
#
# 用法:
#   codex-switch status    # 当前模式、auth 类型、历史会话 provider 分布
#   codex-switch relay     # 切到 www.cctq.ai/v1 中转 (key 需先存入 ~/.codex/cctq.key)
#   codex-switch official  # 切回 ChatGPT 订阅 (恢复 ~/.codex/auth.official.json)
#   codex-switch sync      # 只做会话元数据同步(对齐到当前 provider),不切换
#
# 设计说明:
# - 新版 Codex (>=0.145) 禁止覆写内置 provider id "openai",中转必须用独立 id
#   "cctq"。/resume 按 provider 过滤历史会话,id 一变历史就"消失"(文件没丢)。
#   因此每次切换后自动做 Dailin521/codex-provider-sync 同款恢复:
#   把 state_*.sqlite 的 threads.model_provider 和 sessions/ 下各 rollout
#   jsonl 首行 session_meta 的 model_provider 全部改写为当前 provider id。
# - 官方登录态在首次切 relay 时备份到 auth.official.json,切回时恢复。
# - [model_providers.cctq] 配置块一次性写入 config.toml 后不再移除,
#   切换只改根级 model_provider 一行 + auth.json。
# - config.toml 与 auth.json 每次 `codex exec` 进程启动时重读。codex-cli 0.154 起
#   `codex mcp-server` 已被移除,Claude Code 的 codex MCP 注册改为 ARIS 的 codex-exec
#   桥(mcp-servers/codex-exec/server.py):每次工具调用都是一个全新的 codex exec
#   子进程,不存在进程级 auth 缓存,切换后无需重启任何东西,运行中的会话立即生效。
# - 兼容旧版(codex ≤0.153,注册指向 ~/bin/codex-mcp-keeper 包装 `codex mcp-server`,
#   auth 为进程级缓存):切换后仍 pkill 存量 mcp-server,keeper 会自动重拉并重放握手。
set -euo pipefail

CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
CFG="$CODEX_HOME/config.toml"
AUTH="$CODEX_HOME/auth.json"
BAK="$CODEX_HOME/auth.official.json"
KEYFILE="$CODEX_HOME/cctq.key"
RELAY_ID="cctq"
RELAY_URL="https://www.cctq.ai/v1"

die() { echo "codex-switch: $*" >&2; exit 1; }

current_provider() {
  sed -n 's/^model_provider *= *"\([^"]*\)".*/\1/p' "$CFG" | head -1
}

auth_kind() {
  python3 - "$AUTH" <<'PY'
import json,sys
try: d=json.load(open(sys.argv[1]))
except Exception: print("missing"); sys.exit()
if d.get("tokens"): print("chatgpt")
elif d.get("OPENAI_API_KEY"): print("apikey")
else: print("unknown")
PY
}

set_provider() {  # $1 = provider id, 改根级 model_provider 一行
  python3 - "$CFG" "$1" <<'PY'
import re,sys
p,pid=sys.argv[1:3]
src=open(p).read()
new,n=re.subn(r'(?m)^model_provider *=.*$', f'model_provider = "{pid}"', src, count=1)
if n==0: new=f'model_provider = "{pid}"\n'+src
open(p,'w').write(new)
PY
}

ensure_relay_block() {  # 幂等写入 [model_providers.cctq]
  grep -qF "[model_providers.$RELAY_ID]" "$CFG" && return 0
  python3 - "$CFG" "$RELAY_ID" "$RELAY_URL" <<'PY'
import re,sys
p,pid,url=sys.argv[1:4]
block=f'''# BEGIN CODEX-SWITCH RELAY
[model_providers.{pid}]
name = "cctq relay"
base_url = "{url}"
wire_api = "responses"
requires_openai_auth = true
# END CODEX-SWITCH RELAY
'''
src=open(p).read()
anchor="# END CLAUDE SYNC ROOT\n"
if anchor in src:
    src=src.replace(anchor, anchor+"\n"+block, 1)
else:
    m=re.search(r'(?m)^\[', src)
    pos=m.start() if m else len(src)
    src=src[:pos]+block+"\n"+src[pos:]
open(p,'w').write(src)
PY
}

sync_meta() {  # $1 = provider id: 对齐 sqlite + rollout 元数据,并修复 project 列表 (Dailin521 同款)
  python3 - "$CODEX_HOME" "$1" <<'PY'
import glob,json,os,sqlite3,sys
home,pid=sys.argv[1:3]
# 1) threads.model_provider — 库可能在 CODEX_HOME 根目录或 sqlite/ 子目录
dbs=sorted(glob.glob(os.path.join(home,"state_*.sqlite"))
          +glob.glob(os.path.join(home,"sqlite","state_*.sqlite")))
cwds=set()  # 顺带收集线程工作目录,用于第 3 步修复 project 列表
for db in dbs:
    con=sqlite3.connect(db)
    try:
        tables={r[0] for r in con.execute("SELECT name FROM sqlite_master WHERE type='table'")}
        if "threads" in tables:
            cur=con.execute("UPDATE threads SET model_provider=? WHERE model_provider!=?", (pid,pid))
            con.commit()
            if cur.rowcount: print(f"  {os.path.relpath(db,home)}: {cur.rowcount} threads -> {pid}")
            cols={r[1] for r in con.execute("PRAGMA table_info(threads)")}
            q="SELECT DISTINCT cwd FROM threads WHERE cwd!=''"
            if "has_user_event" in cols: q+=" AND has_user_event=1"
            cwds.update(r[0] for r in con.execute(q))
    finally:
        con.close()
# 2) sessions/ 与 archived_sessions/ 下 rollout jsonl 首行 session_meta 的 model_provider
n=0
for sub in ("sessions","archived_sessions"):
    for f in glob.glob(os.path.join(home,sub,"**","*.jsonl"), recursive=True):
        with open(f) as fp:
            first=fp.readline()
            rest=fp.read()
        try: d=json.loads(first)
        except Exception: continue
        pl=d.get("payload") or {}
        if d.get("type")=="session_meta" and pl.get("model_provider") not in (None,pid):
            pl["model_provider"]=pid
            tmp=f+".tmp"
            with open(tmp,"w") as fp:
                fp.write(json.dumps(d,ensure_ascii=False)+"\n"); fp.write(rest)
            os.replace(tmp,f); n+=1
if n: print(f"  rollouts: {n} files -> {pid}")
# 3) 桌面/新版 Codex 的全局 project 列表 (.codex-global-state.json):
#    App 在 provider 不匹配时会把"没有可见线程"的 project 修剪掉;
#    这里用线程 cwd 把缺失的 project 补回(只增不删,改前留 .bak)
gs=os.path.join(home,".codex-global-state.json")
if os.path.exists(gs):
    raw=open(gs).read()
    try: state=json.loads(raw)
    except Exception: state=None
    if isinstance(state,dict):
        added=0
        dirs=[c for c in sorted(cwds) if os.path.isdir(c)]
        for key in ("project-order","electron-saved-workspace-roots"):
            cur=state.get(key)
            if isinstance(cur,list):
                for c in dirs:
                    if c not in cur:
                        cur.append(c); added+=1
        if added:
            open(gs+".bak","w").write(raw)
            open(gs,"w").write(json.dumps(state,ensure_ascii=False,indent=2)+"\n")
            print(f"  project 列表: 补回 {added} 项 (备份在 .codex-global-state.json.bak)")
PY
}

restart_mcp() {  # 旧版兼容:杀掉缓存旧 auth 的 mcp-server(codex ≤0.153 + keeper);codex-exec 桥无需任何重启
  if pkill -f "codex mcp-server" 2>/dev/null; then
    echo "已终止存量 codex mcp-server 进程(auth 为进程级缓存);keeper 会自动重拉,MCP 连接无感存活"
    echo "(仅 keeper 注册之前启动的旧 Claude 会话需要手动 /mcp reconnect 一次)"
  else
    echo "MCP 走 codex-exec 桥(每次调用新起 codex exec,无 auth 缓存),下一次调用即生效,无需重启"
  fi
}

cmd_status() {
  echo "provider : $(current_provider)"
  echo "auth     : $(auth_kind)"
  [ -f "$BAK" ] && echo "官方登录态备份: $BAK (有)" || echo "官方登录态备份: 无"
  [ -s "$KEYFILE" ] && echo "relay key: $KEYFILE (有, $(wc -c <"$KEYFILE") bytes)" || echo "relay key: 无 ($KEYFILE)"
  echo "threads provider 分布:"
  for db in "$CODEX_HOME"/state_*.sqlite; do
    sqlite3 "$db" "SELECT '  '||model_provider||': '||count(*) FROM threads GROUP BY model_provider;" 2>/dev/null || true
  done
}

cmd_relay() {
  [ -s "$KEYFILE" ] || die "先把 relay token 存入 $KEYFILE (printf '%s' 'sk-xxx' > $KEYFILE && chmod 600 $KEYFILE)"
  cp "$CFG" "$CFG.bak.codex-switch"
  if [ "$(auth_kind)" = chatgpt ]; then
    cp "$AUTH" "$BAK"; echo "已备份官方登录态 -> $BAK"
  fi
  python3 - "$AUTH" "$KEYFILE" <<'PY'
import json,sys
auth,keyf=sys.argv[1:3]
key=open(keyf).read().strip()
with open(auth,"w") as f: json.dump({"OPENAI_API_KEY":key},f)
PY
  chmod 600 "$AUTH"
  ensure_relay_block
  set_provider "$RELAY_ID"
  sync_meta "$RELAY_ID"
  restart_mcp
  echo "已切换到 relay ($RELAY_URL, provider id=$RELAY_ID)"
}

cmd_official() {
  cp "$CFG" "$CFG.bak.codex-switch"
  if [ -f "$BAK" ]; then
    cp "$BAK" "$AUTH"; chmod 600 "$AUTH"
  elif [ "$(auth_kind)" != chatgpt ]; then
    die "没有官方登录态备份 ($BAK),请先 codex login"
  fi
  set_provider openai
  sync_meta openai
  restart_mcp
  echo "已切换到官方订阅 (provider id=openai)"
}

case "${1:-status}" in
  status)   cmd_status ;;
  relay)    cmd_relay ;;
  official) cmd_official ;;
  sync)     sync_meta "$(current_provider)"; echo "已同步元数据到 provider=$(current_provider)" ;;
  *) die "用法: codex-switch {status|relay|official|sync}" ;;
esac
